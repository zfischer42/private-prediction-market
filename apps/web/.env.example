# Copy this file to .env and fill in the values from your Supabase project:
# Dashboard -> Project Settings -> API
#
# Both are safe to ship in the browser bundle. The anon key is a public
# identifier, not a secret - every rule that protects data is enforced in
# Postgres (row-level security plus SECURITY DEFINER functions), not by
# hiding this value. Never put the service_role key in here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
